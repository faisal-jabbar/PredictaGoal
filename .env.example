# Firebase Admin SDK credentials
# Option A: Path to service account JSON (recommended)
FIREBASE_SERVICE_ACCOUNT_PATH=secrets/firebase-service-account.json

# Option B: Individual credential fields (if not using JSON file)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Kaggle — new token format (from kaggle.com/settings -> API -> Create New Token)
KAGGLE_API_TOKEN=
