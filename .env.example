# ============================================================
# PredictaGoal — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is gitignored.
# ============================================================

# ── Firebase Admin SDK ──────────────────────────────────────
# Option A: Path to service account JSON (recommended)
FIREBASE_SERVICE_ACCOUNT_PATH=secrets/firebase-service-account.json

# Option B: Individual credential fields (if not using JSON)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Kaggle ───────────────────────────────────────────────────
# New token format from kaggle.com/settings -> API -> Create Token
KAGGLE_API_TOKEN=

# ── Optional: LLM explanations (Phase 02 / Phase 03) ────────
OPENAI_API_KEY=
ENABLE_LLM_EXPLANATIONS=false
ENABLE_LLM_AGENT=false

# ── Phase 03: External data providers ───────────────────────
# Fixtures / results provider (e.g. football-data.org, API-Football)
FOOTBALL_API_KEY=
FOOTBALL_API_BASE_URL=

# Weather provider (e.g. Open-Meteo is free, no key needed)
WEATHER_API_KEY=
WEATHER_API_BASE_URL=

# Injury / squad feed
INJURY_API_KEY=
INJURY_API_BASE_URL=

# ── Phase 03: Email alerts ───────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
ENABLE_EMAIL_ALERTS=false

# ── Phase 03: MLflow ─────────────────────────────────────────
# Leave empty to use local file-based tracking (mlruns/)
MLFLOW_TRACKING_URI=

# ── Phase 03: System ─────────────────────────────────────────
ENVIRONMENT=development
